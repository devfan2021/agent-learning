# 任何 OpenAI 兼容服务都可以：DeepSeek / 通义 / 智谱 / 本地 vLLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat

# Agent 循环的边界
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_S=60

# 单价按 1M tokens 计，填写与账单一致的币种
PRICE_INPUT_PER_M=0.5
PRICE_OUTPUT_PER_M=2.0

TRACE_DIR=traces
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
